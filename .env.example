# ============================================================
# SHAHEEN-YS-UI — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ─── Application Identity ────────────────────────────────────
WEBUI_NAME=SHAHEEN-YS-UI
WEBUI_URL=http://localhost:8080
ENV=dev

# ─── Security ────────────────────────────────────────────────
WEBUI_SECRET_KEY=your-secret-key-here
SESSION_SECRET=your-session-secret-here

# ─── Server ──────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
FORWARDED_ALLOW_IPS='*'
CORS_ALLOW_ORIGIN='*'

# ─── Database ────────────────────────────────────────────────
# PostgreSQL (Railway / production)
DATABASE_URL=
# Secondary DB (optional)
RIDES_URL=

# ─── Ollama (local models) ───────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1

# ─── OpenRouter ──────────────────────────────────────────────
OPENROUTER_API_KEY=

# ─── Anthropic ───────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Google / Gemini ─────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ─── Groq ────────────────────────────────────────────────────
GROQ_API_KEY=

# ─── Mistral ─────────────────────────────────────────────────
MISTRAL_API_KEY=

# ─── xAI (Grok) ──────────────────────────────────────────────
XAI_API_KEY=

# ─── DeepSeek ────────────────────────────────────────────────
DEEPSEEK_API_KEY=

# ─── ElevenLabs (TTS) ────────────────────────────────────────
ELEVENLABS_API_KEY=

# ─── Search & Web Tools ──────────────────────────────────────
TAVILY_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# ─── Slack Integration ───────────────────────────────────────
SLACK_BOT_TOKEN=

# ─── GitHub ──────────────────────────────────────────────────
GITHUB_TOKEN=

# ─── Railway ─────────────────────────────────────────────────
RAILWAY_TOKEN=

# ─── Aider (AI Coding Assistant) ─────────────────────────────
# Set to true to enable the built-in Aider coding assistant
ENABLE_AIDER=false
# Aider uses provider keys above automatically (OPENAI_API_KEY, ANTHROPIC_API_KEY, etc.)

# ─── RAG / Vector Store ──────────────────────────────────────
# Options: chroma (default), pgvector, qdrant, milvus, opensearch
VECTOR_DB=chroma

# ─── Telemetry (disabled by default) ─────────────────────────
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false
ENABLE_MEMORY_SYSTEM_CONTEXT=true
